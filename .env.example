# Web and TCP endpoints
HTTP_PORT=3000
WS_PORT=8080
TCP_HOST=127.0.0.1
TCP_PORT=9000

# Optional HTTPS
CERT_PATH=
KEY_PATH=

# Optional TURN server
TURN_URL=
TURN_USER=
TURN_PASS=
TURN_SECRET=
# all (обычная работа) или relay (проверка TURN на staging)
ICE_TRANSPORT_POLICY=all

# WebRTC voice room limit
VOICE_LIMIT=6

# Optional: isolated runtime storage; keep outside a release directory on VPS
# CHAT_DATA_DIR=/absolute/path/to/private-data
# Half-open WebSockets are removed within two heartbeat intervals
WS_HEARTBEAT_MS=15000
